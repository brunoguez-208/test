{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snip",
  "mainBinaryName": "Snip",
  "version": "1.0.0",
  "identifier": "uy.bruno.snip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Snip",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: asset: http://asset.localhost https://asset.localhost",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self' data:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Bruno",
    "shortDescription": "Recortá videos MP4 en segundos",
    "longDescription": "Snip es un recortador de video ultra rápido para Windows 11.",
    "category": "Video",
    "copyright": "© 2026 Bruno",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": {
      "binaries/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4"
        ],
        "name": "Snip.mp4",
        "description": "Video MP4",
        "role": "Editor",
        "mimeType": "video/mp4"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}